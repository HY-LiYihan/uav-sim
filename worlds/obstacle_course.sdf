<?xml version="1.0" encoding="UTF-8"?>
<!-- Based on the PX4 Harmonic default world's timing and georeference.
     All geometry is local: no Fuel downloads or external meshes are needed.
     The central square x/y in [-15,15] is clear for the supplied flight demos. -->
<sdf version="1.9">
  <world name="obstacle_course">
    <physics name="physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>488</elevation>
    </spherical_coordinates>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <attenuation><range>1000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry><box><size>200 200 1</size></box></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.45 0.5 0.4 1</ambient><diffuse>0.45 0.5 0.4 1</diffuse></material>
        </visual>
        <!-- Painted launch pad; no raised collision surface. -->
        <visual name="launch_pad">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="building_east">
      <static>true</static><pose>28 0 6 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>8 16 12</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 16 12</size></box></geometry><material><ambient>0.65 0.4 0.3 1</ambient><diffuse>0.65 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_west">
      <static>true</static><pose>-28 -8 4 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>10 12 8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10 12 8</size></box></geometry><material><ambient>0.4 0.5 0.65 1</ambient><diffuse>0.4 0.5 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_north">
      <static>true</static><pose>0 30 5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>16 8 10</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 8 10</size></box></geometry><material><ambient>0.6 0.6 0.55 1</ambient><diffuse>0.6 0.6 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static><pose>18 18 3 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><cylinder><radius>1</radius><length>6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>1</radius><length>6</length></cylinder></geometry><material><ambient>0.9 0.65 0.1 1</ambient><diffuse>0.9 0.65 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static><pose>-18 18 4 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><cylinder><radius>1</radius><length>8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>1</radius><length>8</length></cylinder></geometry><material><ambient>0.9 0.65 0.1 1</ambient><diffuse>0.9 0.65 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static><pose>18 -18 2 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><cylinder><radius>1</radius><length>4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>1</radius><length>4</length></cylinder></geometry><material><ambient>0.9 0.65 0.1 1</ambient><diffuse>0.9 0.65 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
